    public Optional<HistoricoEntradaSalida> obtenerUltimoRegistro(String tokenIdentificador, String motivoSalida) {
        List<HistoricoEntradaSalida> registros =
                historicoEntradaSalidaRepository.findByFichaIdentificacionAndMotivoSalidaAndRegistroActivo(tokenIdentificador, motivoSalida);

        return registros.isEmpty() ? Optional.empty() : Optional.of(registros.get(0));
    }

    public Optional<HistoricoEntradaSalida> obtenerUltimoRegistro(String tokenIdentificador, List<String> motivoSalida) {
        List<HistoricoEntradaSalida> registros =
                historicoEntradaSalidaRepository.findByFichaIdentificacionAndMotivoSalidaAndRegistroActivo(tokenIdentificador, motivoSalida);

        return registros.isEmpty() ? Optional.empty() : Optional.of(registros.get(0));
    }

