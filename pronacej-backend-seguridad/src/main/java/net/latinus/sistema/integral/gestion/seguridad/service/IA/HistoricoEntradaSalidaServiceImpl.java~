    @Override
    public RespuestaPorDefectoAuditoria<HistoricoEntradaSalidaDTO> obtenerHistoricoEntradaSalida(HttpServletRequest httpServletRequest,
                                                                                                 BodyEncriptado bodyEncriptado) {
        RespuestaPorDefectoAuditoria<HistoricoEntradaSalidaDTO> df = new RespuestaPorDefectoAuditoria<>();

        try{

            RespuestaPorDefectoAuditoria<BodyJwtValido> df2 = this.jwtProviderService.obtenerBodyJwtApp(httpServletRequest);
            if (!df2.isExito()) {
                df.setMensaje(df2.getMensaje());
                df.setLogOut(true);
                return df;
            }

            RespuestaPorDefectoAuditoria<String> df22 = bodyEncriptado.desencriptarPorEmpresa(this.parametroDelSistemaRepository, null);
            if (!df22.isExito()) {
                df.setMensaje(df22.getMensaje());
                return df;
            }
            String bodyString = df22.getData();

            Empresa empresa = df2.getData().getEmpresa();

            HistoricoEntradaSalidaRequest request = new Gson().fromJson(bodyString, HistoricoEntradaSalidaRequest.class);
            String tokenIdentificador = request.getTokenIdentificador();
            CatalogoDTO catalogoEntrada = request.getTipoEntrada();
            String nemonioMotivoSalida = "";
            List<String> motivosSalida = Arrays.asList("SALIDA_EXTERNAMIENTO", "SALIDA_INFORME_FINAL");

            if(catalogoEntrada.getNemonico().equals("ENTRADA_TRASLADO")){
                nemonioMotivoSalida = "SALIDA_TRASLADO";
            } else if (catalogoEntrada.getNemonico().equals("ENTRADA_FUGA")) {
                nemonioMotivoSalida = "SALIDA_FUGA";
            }else if (catalogoEntrada.getNemonico().equals("ENTRADA_SALIDA_TEMPORAL")) {
                nemonioMotivoSalida = "SALIDA_TEMPORAL";
            }

            Optional<HistoricoEntradaSalida> optHistorico = null;

            if(catalogoEntrada.getNemonico().equals("ENTRADA_INGRESO_NUEVO")) {
                optHistorico = this.obtenerUltimoRegistro(tokenIdentificador, motivosSalida);
            }else{
                optHistorico = this.obtenerUltimoRegistro(tokenIdentificador, nemonioMotivoSalida);
            }



            if(optHistorico.isEmpty()){
                df.llenarRespuestaExitosa("No existe un evento de salida activo para el tipo de entrada ingresado.",
                        new HistoricoEntradaSalidaDTO());
                return df;
            }

            HistoricoEntradaSalida historico = optHistorico.get();
            HistoricoEntradaSalidaDTO dto = new HistoricoEntradaSalidaDTO();
            dto.setFechaSalida(historico.getFechaSalida());
            dto.setMotivoSalida(utilsService.entidadADtoCatalogo(historico.getMotivoSalida()));
            if(nemonioMotivoSalida.equals("SALIDA_TRASLADO")){
                dto.setTraslado(this.entidadADto(historico.getTraslado()));
                TrasladoAdolescenteDTO trasladoAdolescenteDTO = new TrasladoAdolescenteDTO();
                trasladoAdolescenteDTO.setIdTrasladoAdolescente(historico.getTrasladoAdolescente().getIdTrasladoAdolescente());
                dto.setTrasladoAdolescente(trasladoAdolescenteDTO);
            }else if(nemonioMotivoSalida.equals("SALIDA_TEMPORAL")){
                dto.setPermisoSalida(this.entidadADto(historico.getPermisoSalida()));
            }else if(nemonioMotivoSalida.equals("SALIDA_FUGA")){
                dto.setFuga(this.entidadADto(historico.getEventoFuga()));
            }
            else if(catalogoEntrada.getNemonico().equals("ENTRADA_INGRESO_NUEVO")){
                if(!ObjectUtils.isEmpty(historico.getExternamiento())){
                    dto.setActaExternamiento(entidadADtoermisoExternamiento(historico.getExternamiento()));
                }else if(!ObjectUtils.isEmpty(historico.getInformeFinalAbierto())){

                }

            }
            if(!ObjectUtils.isEmpty(historico.getRegistroSalida())){
                dto.setRegistroSalida(this.entidadADto(historico.getRegistroSalida()));
            }


            dto.setCentroSalida(this.utilsService.entidadADtoJerarquia(historico.getCentroSalida()));

            df.llenarRespuestaExitosa("Se ha creado con éxito el registro.", dto);

        }catch (Exception ex) {
            df.llenarConDatosDeException(ex);
        }

        return df;
    }

