     *
     * @param bodyEncriptado el PlanTratamientoIndIntervDT que se actualizará
     * @return el RespuestaPorDefectoAuditoria<ActividadIntervencionDTO> correspondiente
     */
    RespuestaPorDefectoAuditoria<ActividadIntervencionDTO> crearActualizarActividadIntervencion(HttpServletRequest httpServletRequest,
                                                                                                BodyEncriptado bodyEncriptado);

    /**
